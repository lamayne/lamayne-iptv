<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration to paste into SignPath (Project > Artifact Configurations).
  The installers folder is sent as a ZIP, so the root element is <zip-file>.
  Each installer .exe is signed (Authenticode).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="LAMAYNE-IPTV_*_x64-setup*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
